---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import {
  AGGREGATE_CATEGORIES,
  AGGREGATE_TOTAL_LITERS,
  AGGREGATE_TOTAL_MULTIPLE_2026_MAX,
  AGGREGATE_TOTAL_MULTIPLE_2026_MIN,
  AGGREGATE_TOTAL_MULTIPLE_MAX,
  AGGREGATE_TOTAL_MULTIPLE_MIN,
  AI_2025_MAX_LITERS,
  AI_2025_MIN_LITERS,
  AI_2026_MAX_LITERS,
  AI_2026_MIN_LITERS,
  AI_BENCHMARK_SOURCE,
  AI_POWER_GROWTH_2025_TO_2026,
  ALMOND_FOOTPRINT_L_PER_KG,
  ALMOND_FOOTPRINT_L_PER_KG_CALIFORNIA,
  ALMOND_KERNEL_GRAMS,
  ALTMAN_ALMOND_SOURCE,
  ALTMAN_IMPLIED_LITERS_PER_ALMOND,
  ALTMAN_QUERIES_PER_ALMOND,
  COFFEE_GREEN_KG_2024,
  DEFAULT_SCOPE_ID,
  DEFAULT_WORKLOAD_ID,
  MILK_POUNDS_2025,
  ORANGE_JUICE_GALLONS_2022,
  QUERIES_PER_DAY,
  QUERIES_PER_DROP,
  QUERY_SCOPES,
  SCOPED_DRINKS,
  UNU_ABOVE_HIGH_PCT,
  UNU_AI_ELECTRICITY_SHARE,
  UNU_AI_WATER_2025_LITERS,
  UNU_DC_ELECTRICITY_WATER_2025_LITERS,
  WORKLOAD_TIERS,
  formatFootprint,
  formatLiters,
  formatLitersRange,
  formatMultipleRange,
  roundToSigFigs,
} from '../lib/drinking-ai';
const chartMaxLiters = Math.max(...AGGREGATE_CATEGORIES.map((c) => c.totalWaterLiters));

const clientDrinks = SCOPED_DRINKS.map((d) => {
  // One cell per (scope × workload) combination, computed and tested in the lib.
  const byCombo = d.cells;
  // Default range: across accounting scopes at the default workload, so the unit
  // stays consistent (the client recomputes it when the workload changes).
  const defScopeCounts = QUERY_SCOPES.map((s) => byCombo[`${s.id}:${DEFAULT_WORKLOAD_ID}`].count);
  return {
    id: d.id,
    name: d.name,
    headline: d.headline ?? d.name.toLowerCase(),
    serving: d.serving,
    waterLiters: d.waterLiters,
    waterLabel: formatFootprint(d.waterLiters),
    derivation: d.derivation,
    scopeNote: d.scopeNote,
    sources: d.sources,
    flagged: d.flagged ?? false,
    byCombo,
    rangeLow: Math.min(...defScopeCounts),
    rangeHigh: Math.max(...defScopeCounts),
  };
});

const clientScopes = QUERY_SCOPES.map((s) => ({
  id: s.id,
  label: s.label,
  boundary: s.boundary,
  perQueryMl: s.perQueryMl,
  detail: s.detail,
  sourceLabel: s.sourceLabel,
  sourceUrl: s.sourceUrl,
}));

const clientWorkloads = WORKLOAD_TIERS.map((w) => ({
  id: w.id,
  label: w.label,
  unit: w.unit,
  daily: w.daily,
  unitSingular: w.unitSingular,
  multiple: w.multiple,
  detail: w.detail,
  sourceLabel: w.sourceLabel,
  sourceUrl: w.sourceUrl,
  estimate: w.estimate ?? false,
}));

const defaultDrink = clientDrinks[0];
const defaultScope = clientScopes.find((s) => s.id === DEFAULT_SCOPE_ID) ?? clientScopes[0];
const defaultWorkload = clientWorkloads.find((w) => w.id === DEFAULT_WORKLOAD_ID) ?? clientWorkloads[0];
const defaultCell = defaultDrink.byCombo[`${defaultScope.id}:${defaultWorkload.id}`];
const defaultPerUnitMl = defaultScope.perQueryMl * defaultWorkload.multiple;

// Beer at the default scope, in each workload unit — for the "shift to agents" strip.
const heroBeer = clientDrinks.find((d) => d.id === 'beer') ?? clientDrinks[0];
const beerUnits = WORKLOAD_TIERS.map((w) => ({
  label: w.unit,
  multiple: w.multiple,
  count: heroBeer.byCombo[`${DEFAULT_SCOPE_ID}:${w.id}`].count,
}));

// The almond and the glass of almond milk at the default scope, for the lede.
// A renamed id fails the build instead of silently printing the beer count.
const byId = (id: string) => {
  const found = clientDrinks.find((d) => d.id === id);
  if (!found) throw new Error(`missing drink ${id}`);
  return found;
};
const defaultCombo = `${DEFAULT_SCOPE_ID}:${DEFAULT_WORKLOAD_ID}`;
const heroAlmond = byId('almond').byCombo[defaultCombo].count;
const heroAlmondMilk = byId('almond-milk').byCombo[defaultCombo].count;
// The same almond on the California-specific footprint at the default scope.
const heroAlmondCalifornia = roundToSigFigs(
  (ALMOND_FOOTPRINT_L_PER_KG_CALIFORNIA * ALMOND_KERNEL_GRAMS) / defaultScope.perQueryMl,
);
// The aggregate at the most aggressive published AI-growth rate (de Vries-Gao's own 2024→2025 pace).
const AI_GROWTH_HIGH = 2.45;
const growthHighMin = AGGREGATE_TOTAL_LITERS / (AI_2025_MAX_LITERS * AI_GROWTH_HIGH);
const growthHighMax = AGGREGATE_TOTAL_LITERS / (AI_2025_MIN_LITERS * AI_GROWTH_HIGH);
// One formatter for the per-unit mL, shared by the server render and the client script.
const fmtMl = (ml: number) => (ml < 1 ? ml.toFixed(2) : String(Math.round(ml * 100) / 100));

// Beer in agentic tasks at the default and lifecycle scopes, for the horizon caveat.
const beerAgenticDefault = heroBeer.byCombo[`${DEFAULT_SCOPE_ID}:agentic`].count;
const beerAgenticLifecycle = heroBeer.byCombo['lifecycle:agentic'].count;
// The almond claim check, in liters (scope-independent).
const californiaAlmondLiters = ALMOND_FOOTPRINT_L_PER_KG_CALIFORNIA * (ALMOND_KERNEL_GRAMS / 1000);
const globalAlmondLiters = ALMOND_FOOTPRINT_L_PER_KG * (ALMOND_KERNEL_GRAMS / 1000);
// AI bars as a share of the longest drink bar, for the chart legend and the per-row reference line.
const pct = (liters: number) => (liters / chartMaxLiters) * 100;
const aiHiPct = pct(AI_2025_MAX_LITERS);
const aiSharePct = (lo: number, hi: number) => `${pct(lo).toFixed(1)}–${pct(hi).toFixed(1)}%`;
const topCategoryName = AGGREGATE_CATEGORIES[0].name.toLowerCase();

const COUNT_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const categoryCountWord = COUNT_WORDS[AGGREGATE_CATEGORIES.length] ?? String(AGGREGATE_CATEGORIES.length);

const sourceCards = [
  {
    group: 'AI water',
    title: 'OpenAI / Sam Altman',
    detail: 'Average ChatGPT query: 0.34 Wh and 0.000085 gallons (0.32 mL) of water; the post states no boundary. June 10, 2025.',
    url: 'https://blog.samaltman.com/the-gentle-singularity',
  },
  {
    group: 'AI water',
    title: 'Sam Altman on Sources, Sept 2, 2026',
    detail: '"For every 38,000 ChatGPT queries, that is the same amount of water that is used in the production of a single almond in California" — cited from memory. Quoted by Tom\'s Hardware.',
    url: ALTMAN_ALMOND_SOURCE.url,
  },
  {
    group: 'AI water',
    title: 'Google Cloud',
    detail: 'Median Gemini Apps text prompt: 0.24 Wh and 0.26 mL of water, defined as data-center cooling only. 2025.',
    url: 'https://cloud.google.com/blog/products/infrastructure/measuring-the-environmental-impact-of-ai-inference/',
  },
  {
    group: 'AI water',
    title: 'Jegham et al. 2025',
    detail: '"How hungry is AI?" (arXiv preprint, v6 Nov 2025). Adds power-plant water: a short GPT-4o query (ChatGPT\'s default until Aug 2025), about 300 output tokens, lands near 2 mL; a 1,000-token response near 6 mL.',
    url: 'https://arxiv.org/abs/2505.09598',
  },
  {
    group: 'AI water',
    title: 'Mistral AI',
    detail: 'Life-cycle assessment, ISO 14040/44-compliant and reviewed by the audit consultancies Resilio and Hubblo: 45 mL of water per 400-token Le Chat response, marginal inference only. July 2025.',
    url: 'https://mistral.ai/news/our-contribution-to-a-global-environmental-standard-for-ai',
  },
  {
    group: 'AI water',
    title: 'Li, Yang, Islam & Ren — "Making AI less thirsty"',
    detail: 'GPT-3 on 2023 hardware at US-average WUE: a 500 mL bottle per 10–50 medium-length responses; 2027 global AI withdrawal projected at 4.2–6.6 billion m³. Communications of the ACM 68(7), July 2025; arXiv copy linked.',
    url: 'https://arxiv.org/abs/2304.03271',
  },
  {
    group: 'AI water',
    title: 'de Vries-Gao, Patterns 2026',
    detail: "AI's modeled global water footprint reaches 312.5–764.6 billion liters in 2025.",
    url: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC12827721/',
  },
  {
    group: 'AI water',
    title: 'LBNL 2024 data-center report',
    detail: 'US data centers consumed 66 billion liters (17.4 billion gallons) on-site in 2023, plus ~800 billion liters via electricity at 4.52 L/kWh. The latest LBNL water figures; the June 2026 update covers electricity only.',
    url: 'https://eta-publications.lbl.gov/sites/default/files/2024-12/lbnl-2024-united-states-data-center-energy-usage-report_1.pdf',
  },
  {
    group: 'Workload & growth',
    title: 'Anthropic engineering',
    detail: 'Multi-agent systems used about 15× the tokens of a chat interaction; single agents about 4×.',
    url: 'https://www.anthropic.com/engineering/multi-agent-research-system',
  },
  {
    group: 'Workload & growth',
    title: 'Epoch AI',
    detail: 'A typical query is ~0.3 Wh; reasoning models emit ~2.5× the tokens. Feb 2025.',
    url: 'https://epoch.ai/gradient-updates/how-much-energy-does-chatgpt-use',
  },
  {
    group: 'Workload & growth',
    title: 'Epoch AI data insight',
    detail: 'AI data-center power capacity reached about 30 GW in the last quarter of 2025. Jan 2026.',
    url: 'https://epoch.ai/data-insights/ai-datacenter-power',
  },
  {
    group: 'Workload & growth',
    title: 'IEA — Energy and AI',
    detail: 'Data-center electricity 415 TWh (2024) to ~945 TWh by 2030; accelerated servers grow ~30% a year. April 2025.',
    url: 'https://www.iea.org/reports/energy-and-ai',
  },
  {
    group: 'Workload & growth',
    title: 'IEA — Key questions on energy and AI',
    detail: 'April 2026 update: data-center electricity 485 TWh (2025) to ~950 TWh (2030); AI-focused data centers triple to ~465 TWh.',
    url: 'https://www.iea.org/reports/key-questions-on-energy-and-ai',
  },
  {
    group: 'Workload & growth',
    title: 'UN University (UNU-INWEH)',
    detail: "The water footprint of data centers' 2025 electricity (448 TWh) was 4.5 trillion liters, heading toward 9.3 trillion by 2030; AI was ~20% of that electricity, implying ~0.9 trillion liters. June 2026.",
    url: 'https://unu.edu/inweh/news/environmental-cost-of-AIs-Enrgy-use-carbon-water-and-land-footprints',
  },
  {
    group: 'Drink footprints',
    title: 'Mekonnen & Hoekstra 2011',
    detail: 'The canonical crop-water table: beer 298, wine 869, orange juice 1,018, coffee 18,925, tea 8,856 L/kg.',
    url: 'https://hess.copernicus.org/articles/15/1577/2011/hess-15-1577-2011.pdf',
  },
  {
    group: 'Drink footprints',
    title: 'Mekonnen & Hoekstra 2012',
    detail: 'Farm-animal products: milk at 1,020 L/kg.',
    url: 'https://www.waterfootprint.org/resources/Mekonnen-Hoekstra-2012-WaterFootprintFarmAnimalProducts_1.pdf',
  },
  {
    group: 'Drink footprints',
    title: 'Fulton, Norton & Shilling 2019',
    detail: 'California almonds, 2004–2015: 10,240 L per kg of kernel, about 12 L per almond, against 16,095 L per kg in the global table. Ecological Indicators, open access.',
    url: 'https://doi.org/10.1016/j.ecolind.2017.12.063',
  },
  {
    group: 'Drink footprints',
    title: 'Poore & Nemecek 2018',
    detail: 'Freshwater withdrawals per liter of milk: almond 371, oat 48, soy 28, dairy 628 — irrigation and processing water only, no rain. Via Our World in Data.',
    url: 'https://ourworldindata.org/environmental-impact-milks',
  },
  {
    group: 'Drink footprints',
    title: 'Almond Breeze label',
    detail: 'Ingredients: "Spring water, almonds (2%)…" — the almond share behind the almond-milk figure.',
    url: 'https://groceries.morrisons.com/products/blue-diamond-almonds-almond-breeze-unsweetened/111103900',
  },
  {
    group: 'Drink footprints',
    title: 'Oatly label',
    detail: 'Ingredients: "Water, oats 10%…" — the oat share behind the oat-milk figure.',
    url: 'https://www.oatly.com/en-gb/products/oat-drink/oat-drink-whole-2-8-1l',
  },
  {
    group: 'Drink footprints',
    title: 'USDA FoodData Central',
    detail: 'One almond kernel weighs 1.2 g; 23 kernels to the ounce.',
    url: 'https://fdc.nal.usda.gov/food-details/170567/nutrients',
  },
  {
    group: 'Drink footprints',
    title: 'Chapagain & Hoekstra 2007',
    detail: 'The classic study: 140 liters per 125 mL cup of coffee (7 g roasted); 34 liters per 250 mL cup of tea (3 g), 17 for weak tea (1.5 g).',
    url: 'https://ayhoekstra.nl/pubs/Chapagain-Hoekstra-2007.pdf',
  },
  {
    group: 'Drink footprints',
    title: 'Ercin, Aldaya & Hoekstra 2011',
    detail: 'Sugar-containing carbonated beverage: 169–309 liters per 0.5-liter bottle; 99.7–99.8% in the supply chain.',
    url: 'https://ayhoekstra.nl/pubs/Ercin-et-al-2011.pdf',
  },
  {
    group: 'Drink footprints',
    title: 'IBWA 2024 benchmarking',
    detail: 'Bottled water facilities used 1.39 liters of water per liter bottled in 2022.',
    url: 'https://bottledwater.org/wp-content/uploads/2024/08/IBWA-Benchmarking-Executive-Summary_May-2024.pdf',
  },
  {
    group: 'Drink footprints',
    title: 'spiritsEUROPE 2020',
    detail: 'Industry figure: about 18 liters of water per serving of spirits. Not peer-reviewed.',
    url: 'https://spirits.eu/upload/files/publications/CP.MI-165-2020-%20Farm2Glass%20Brochure%20-%2014%20May%202020.pdf',
  },
  {
    group: 'US volumes',
    title: 'NIAAA Surveillance Report 122',
    detail: 'US beer (6.17 billion gallons) and wine (0.89 billion gallons), 2023.',
    url: 'https://www.niaaa.nih.gov/sites/default/files/surveillance-report122.Per-Capita-Consumption.pdf',
  },
  {
    group: 'US volumes',
    title: 'USDA ERS fruit-juices table',
    detail: `US orange juice: ${(ORANGE_JUICE_GALLONS_2022 / 1e6).toFixed(1)} million gallons in 2022, the latest year in the series.`,
    url: 'https://ers.usda.gov/media/5349/fruit-juices.csv?v=60123',
  },
  {
    group: 'US volumes',
    title: 'USDA ERS dairy data',
    detail: `US fluid milk sales: ${(MILK_POUNDS_2025 / 1e9).toFixed(1)} billion pounds in 2025.`,
    url: 'https://www.ers.usda.gov/data-products/dairy-data/',
  },
  {
    group: 'US volumes',
    title: 'USDA FAS coffee report',
    detail: `US green-coffee consumption: ${(COFFEE_GREEN_KG_2024 / 60 / 1e6).toFixed(1)} million 60-kg bags in 2024/25 (July 2026 edition).`,
    url: 'https://apps.fas.usda.gov/psdonline/circulars/coffee.pdf',
  },
  {
    group: 'US volumes',
    title: 'Tea Association of the USA',
    detail: 'Americans drank about 86 billion servings of tea in 2024, about 4 billion gallons; black and green tea imports ran 265–270 million lb.',
    url: 'https://www.teausa.org/tea-fact-sheet',
  },
  {
    group: 'US volumes',
    title: 'IBWA 2026 progress report',
    detail: 'Preliminary 2025: 16.8 billion gallons of bottled water; 47.5 gallons per person of bottled water and 33.9 of soda.',
    url: 'https://bottledwater.org/wp-content/uploads/2026/01/2025-Progress-Report_FINAL.pdf',
  },
  {
    group: 'US volumes',
    title: 'NMPF, citing Circana',
    detail: 'US plant-based milk alternatives: 358.4 million gallons at retail in 2025, down 6%; almond drinks are 63% of the category.',
    url: 'https://www.nmpf.org/real-milk-extends-its-comeback/',
  },
  {
    group: 'Context',
    title: 'Andy Masley',
    detail: '"Using ChatGPT is not bad for the environment" — the post that prompted this page.',
    url: 'https://blog.andymasley.com/p/individual-ai-use-is-not-bad-for',
  },
];

const sourceGroups = ['AI water', 'Workload & growth', 'Drink footprints', 'US volumes', 'Context'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Drinking AI | ${SITE_TITLE}`}
			description={`One almond ≈ ${heroAlmond.toLocaleString()} ChatGPT queries, one beer ≈ ${defaultCell.count.toLocaleString()}: drinks priced in AI water across three accounting scopes, every source linked.`}
			image="/og/drinking-ai.png"
		/>
	</head>
	<body>
		<Header />
		<main class="drinking-ai-page">
			<div class="page-atmosphere" aria-hidden="true"></div>

			<section class="poster">
				<span class="section-kicker">Water arithmetic</span>
				<h1 class="poster-title">Drinking AI</h1>
				<p class="lede">
					Asking ChatGPT 30 questions a day for a year uses about <strong>a fifth of the
					water behind one beer</strong> — counting data-center cooling plus the water used
					to generate the query's electricity, the closest AI analog to how the drink
					figures count the water behind the crops. Pick a drink, shift the scope, or
					count by agentic tasks; then compare whole US drink categories with the modeled
					water footprint of all AI in 2025, and with a 2026 extrapolation (a Claude estimate).
				</p>
				<p class="lede-note">
					Sam Altman's September 2026 line — one California almond takes the water of
					38,000 queries — works out at OpenAI's 0.32 mL per query and the California-specific
					almond footprint: {ALTMAN_IMPLIED_LITERS_PER_ALMOND.toFixed(1)} L against {californiaAlmondLiters.toFixed(1)} L. At this page's default scope, one
					almond ≈ {heroAlmond.toLocaleString()} queries, and a glass of almond milk, about four almonds,
					≈ {heroAlmondMilk.toLocaleString()}.
				</p>
			</section>

			<section class="workspace animate-fade-in-up delay-100" aria-labelledby="calculator-heading">
				<h2 id="calculator-heading" class="sr-only">One drink, or one almond, in ChatGPT queries</h2>

				<div class="console">
					<section class="result-panel">
						<p class="sr-only" aria-live="polite" aria-atomic="true" data-result-announce>One {defaultDrink.headline} is about {defaultCell.count.toLocaleString()} {defaultWorkload.unit}, enough water for {QUERIES_PER_DAY} {defaultWorkload.daily} a day for {defaultCell.usage}.</p>
						<div class="result-label">One <span data-result-name>{defaultDrink.headline}</span> ≈</div>
						<div class="result-number" data-result-number aria-hidden="true">{defaultCell.count.toLocaleString()}</div>
						<div class="result-unit" data-result-unit>{defaultWorkload.unit}</div>
						<p class="result-usage">
							Enough water for {QUERIES_PER_DAY} <span data-result-daily>{defaultWorkload.daily}</span> a day for
							<strong data-result-usage>{defaultCell.usage}</strong>.
						</p>
						<p class="result-range">
							All scopes: <span data-result-range>{defaultDrink.rangeLow.toLocaleString()}–{defaultDrink.rangeHigh.toLocaleString()}</span> <span data-result-range-unit>{defaultWorkload.daily}</span>.
						</p>
						<div class="claim-check" data-claim-check hidden>
							<div class="unit-row">
								<span class="unit-count">{ALTMAN_IMPLIED_LITERS_PER_ALMOND.toFixed(1)} L</span>
								<span class="unit-name">Altman's {ALTMAN_QUERIES_PER_ALMOND.toLocaleString()} queries × OpenAI's 0.32 mL</span>
							</div>
							<div class="unit-row">
								<span class="unit-count">{californiaAlmondLiters.toFixed(1)} L</span>
								<span class="unit-name">one California almond (Fulton et al. 2019)</span>
							</div>
							<div class="unit-row">
								<span class="unit-count">{globalAlmondLiters.toFixed(1)} L</span>
								<span class="unit-name">global-average almond (Mekonnen &amp; Hoekstra), the table every item here uses</span>
							</div>
							<button type="button" class="claim-scope" data-set-scope="onsite">Use his 0.32 mL scope</button>
						</div>
					</section>

					<div class="console-controls">
						<div class="controls" role="group" aria-label="Drink or item selector">
							{clientDrinks.map((drink, index) => (
								<button
									type="button"
									class={`drink-button${index === 0 ? ' is-active' : ''}${drink.id === 'almond' ? ' drink-button--check' : ''}`}
									aria-pressed={index === 0 ? 'true' : 'false'}
									data-drink={drink.id}
								>
									<span class="drink-name">{drink.name}</span>
									<span class="drink-serving">{drink.serving}{drink.id === 'almond' ? ` · Altman: ${ALTMAN_QUERIES_PER_ALMOND.toLocaleString()} queries` : ''}</span>
								</button>
							))}
						</div>

						<div class="scope-control">
							<span class="scope-label">Water counted per unit</span>
							<div class="scope-pills" role="group" aria-label="AI water-accounting scope">
								{clientScopes.map((scope) => (
									<button
										type="button"
										class={`scope-pill${scope.id === defaultScope.id ? ' is-active' : ''}`}
										aria-pressed={scope.id === defaultScope.id ? 'true' : 'false'}
										data-scope={scope.id}
									>
										<span class="scope-pill-label">{scope.label}</span>
										<span class="scope-pill-ml">{scope.perQueryMl < 1 ? scope.perQueryMl.toFixed(2) : scope.perQueryMl} mL</span>
									</button>
								))}
							</div>
						</div>

						<div class="scope-control workload-control" id="counting-by">
							<span class="scope-label">Counting by</span>
							<div class="scope-pills" role="group" aria-label="AI workload unit">
								{clientWorkloads.map((workload) => (
									<button
										type="button"
										class={`scope-pill${workload.id === defaultWorkload.id ? ' is-active' : ''}`}
										aria-pressed={workload.id === defaultWorkload.id ? 'true' : 'false'}
										data-workload={workload.id}
									>
										<span class="scope-pill-label">{workload.label}{workload.estimate && <span class="flag-tag">Claude estimate</span>}</span>
										<span class="scope-pill-ml">{workload.multiple}×</span>
									</button>
								))}
							</div>
						</div>
					</div>

					<div class="dot-field-card">
						<div class="dot-field-header">
							<span class="dot-legend"><span class="dot-swatch" aria-hidden="true"></span>1 drop = {QUERIES_PER_DROP.toLocaleString()} <span data-dot-unit>{defaultWorkload.daily}</span></span>
							<span class="dot-count"><strong data-dot-count>{defaultCell.drops.toLocaleString()}</strong> <span data-drops-word>{defaultCell.drops === 1 ? 'drop' : 'drops'}</span></span>
						</div>
						<div class="dot-field" data-dot-field aria-hidden="true">{Array.from({ length: defaultCell.drops }).map(() => <span class="dot" />)}</div>
					</div>
				</div>

				<aside class="detail-rail" aria-label="How the number is computed">
					<div class="detail-item">
						<div class="detail-label">
							Water footprint
